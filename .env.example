# ---------------------------------------------------------------------------
# Vorlage fuer Umgebungsvariablen.
# Kopiere diese Datei zu ".env" (gleicher Ordner) und trage deine Werte ein.
#   cp .env.example .env
# Die ".env" wird per .gitignore ausgeschlossen — NIE committen oder teilen!
# Den Pipedrive-Token bekommst du in Pipedrive:
#   Einstellungen -> Persoenliche Einstellungen -> API -> Token (neu) generieren
# ---------------------------------------------------------------------------

# Pipedrive (Live-CRM). Alle drei noetig, damit wirklich geschrieben wird:
# PIPEDRIVE_API_BASE=https://example.pipedrive.com
# PIPEDRIVE_API_TOKEN=dein_pipedrive_api_token_hier
# PIPEDRIVE_LIVE=1

# Optional, falls deine Pipeline/Phase anders heisst:
# PIPEDRIVE_PIPELINE=ScoutRef Scouting
# PIPEDRIVE_STAGE=Vorqualifiziert
# PIPEDRIVE_POLL_SECONDS=60

# Anzeigename fuer das Organisationsfeld 'Zustaendig'. Muss exakt einer
# Option dieses Felds in Pipedrive entsprechen, sonst bleibt es leer.
# PIPEDRIVE_OWNER=Vorname Nachname

# WICHTIG: Vor dem ersten Live-Schreiben pruefen, ob alle Feldnamen passen:
#   python3 pipedrive_selfcheck.py
# Das Skript schreibt nichts, es meldet nur fehlende Felder und Optionen.

# Optional: Live-Discovery/-Outreach ueber die OpenAI Responses API:
# OPENAI_API_KEY=sk-...

# Modell- und Versuchssteuerung (SAS, Scouting und Verifikation im
# Primaervergleich stets auf dieselbe Modell-ID setzen):
# SCOUTREF_OPENAI_MODEL=gpt-6.1-sol
# SCOUTREF_SCOUT_MODEL=gpt-6.1-sol
# SCOUTREF_VERIFY_MODEL=gpt-6.1-sol
# SCOUTREF_SAS_MODEL=gpt-6.1-sol
# SCOUTREF_OUTREACH_MODEL=gpt-6.1-sol
# SCOUTREF_REASONING_EFFORT=low
# Bezahlte Vergleichslaeufe bleiben aus, solange dieser Schalter nicht bewusst
# auf 1 gesetzt wird. Ein vorhandener API-Schluessel allein genuegt nicht.
# SCOUTREF_EVAL_LIVE_ENABLED=0
# Zusaetzlicher, selbst gewaehlter Schutzwert fuer schreibende API-Aufrufe:
# SCOUTREF_OPERATOR_TOKEN=replace-with-a-long-random-value
# Globale Obergrenzen je Architekturarm:
# SCOUTREF_EVAL_MAX_INPUT_TOKENS=200000
# SCOUTREF_EVAL_MAX_OUTPUT_TOKENS=16000
# SCOUTREF_EVAL_MAX_REASONING_TOKENS=8000
# SCOUTREF_EVAL_MAX_TOOL_CALLS=12
# SCOUTREF_EVAL_MAX_MODEL_CALLS=2
# SCOUTREF_EVAL_MAX_RESOLVER_FETCHES=24
# SCOUTREF_EVAL_MAX_COST_USD=0.75
# SCOUTREF_WEB_SEARCH_MAX_USES=5

# Organisationsneutrale Instanz. Reale Stammdaten bleiben ausserhalb des
# veroeffentlichbaren Repositories.
# SCOUTREF_INSTANCE_PATH=config/instance.default.json
# SCOUTREF_APPLICATION_NAME=Public Scouting Lab
# SCOUTREF_APPLICATION_LOCATION=
# SCOUTREF_PREFERRED_REGIONS=DE,AT,CH
# SCOUTREF_SENDER_NAME=Vorname Nachname
# SCOUTREF_SENDER_ROLE=Startup Scouting
# SCOUTREF_SENDER_ORGANIZATION=Beispielorganisation
# Optional: privater Laufzeitordner und lokaler SQLite-Pfad:
# SCOUTREF_RUNTIME_ROOT=/sicherer/lokaler/pfad/scoutref-runtime
# SCOUTREF_SQLITE_PATH=/sicherer/lokaler/pfad/scoutref-runtime/scoutref.db
