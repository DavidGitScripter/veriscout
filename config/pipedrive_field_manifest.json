    {"name": "Gründungsjahr", "field_type": "double"},
    {"name": "Entwicklungsphase", "field_type": "enum", "options": ["Unbekannt", "Pre-Seed", "Seed", "Series A", "Series B", "Bootstrapped"]},
    {"name": "Technologie", "field_type": "set", "options": ["KI & Advanced Analytics", "Sensorik", "Robotik & Automation", "Embedded Systems", "Materials & Chemistry", "Energiesysteme", "Software", "Fertigungsverfahren", "Bau-/Hardware-Systeme"]},
    {"name": "Evidenzstatus Unternehmen", "field_type": "enum", "options": ["Vollständig belegt", "Unvollständig", "Widersprüchlich", "Veraltet", "Nicht zulässig"]}
  ],
  "person_fields": [],
  "deal_fields": [
    {"name": "ScoutRef Relation-ID", "field_type": "varchar"},
    {"name": "Zielorganisation", "field_type": "org"},
    {"name": "ScoutRef Lauf-ID", "field_type": "varchar"},
    {"name": "Evidenzstatus Bewertung", "field_type": "enum", "options": ["Vollständig belegt", "Unvollständig", "Widersprüchlich", "Veraltet", "Nicht zulässig"]},
    {"name": "Kurzbegründung", "field_type": "text"},
    {"name": "Freigegeben von", "field_type": "user"},
    {"name": "Freigabedatum", "field_type": "date"},
    {"name": "Priorität", "field_type": "enum", "options": ["Hoch", "Mittel", "Niedrig"], "human_only": true}
  ],
  "pipeline": {
    "name": "ScoutRef Scouting",
    "stages": ["Vorqualifiziert", "Kontakt vorbereitet", "Kontakt aufgenommen", "Termin vereinbart", "Kooperationsprüfung", "Follow-up"]
  },
